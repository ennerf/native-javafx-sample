<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>us.hebi.graalvm.samples</groupId>
    <artifactId>fx-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <graalvm.version>22.3.2</graalvm.version>
        <graalvm.tools.version>0.9.21</graalvm.tools.version>
        <javafx.version>21</javafx.version>
        <javafx.scope>provided</javafx.scope>

        <native.os>${os.name}</native.os>
        <native.arch>${os.arch}</native.arch>
        <outputDir>${project.build.directory}/image/${native.os}-${native.arch}</outputDir>
        <imageName>${artifactId}</imageName>
        <mainClass>us.hebi.samples.gui.MinimalFxAppLauncher</mainClass>

        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <native.compiler></native.compiler>

    </properties>

    <modules>
        <module>native-executable</module>
        <module>native-sharedlib</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.graalvm.nativeimage</groupId>
                <artifactId>native-image-base</artifactId>
                <version>23.1.1</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-base</artifactId>
                <version>${javafx.version}</version>
                <scope>${javafx.scope}</scope>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-graphics</artifactId>
                <version>${javafx.version}</version>
                <scope>${javafx.scope}</scope>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-controls</artifactId>
                <version>${javafx.version}</version>
                <scope>${javafx.scope}</scope>
            </dependency>
            <dependency>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-fxml</artifactId>
                <version>${javafx.version}</version>
                <scope>${javafx.scope}</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <profiles>
        <profile>
            <id>platform-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <native.os>windows</native.os>
                <native.compiler>cl</native.compiler>
            </properties>
        </profile>
        <profile>
            <id>platform-osx</id>
            <activation>
                <os>
                    <name>mac os x</name>
                </os>
            </activation>
            <properties>
                <native.os>osx</native.os>
                <native.compiler>cc</native.compiler>
            </properties>
        </profile>
        <profile>
            <id>platform-linux</id>
            <activation>
                <os>
                    <name>linux</name>
                </os>
            </activation>
            <properties>
                <native.os>linux</native.os>
                <native.compiler>gcc</native.compiler>
            </properties>
        </profile>
    </profiles>


</project>